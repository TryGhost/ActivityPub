#!/usr/bin/env bash

# Applies all migrations to a throwaway MySQL container and writes the
# resulting schema to migrate/schema.sql

set -euo pipefail

compose() {
    docker compose --profile schema "$@"
}

mysql_exec() {
    compose exec -T -e MYSQL_PWD=root mysql-schema "$@"
}

out=migrate/schema.sql

trap 'rm -f "$out.tmp"; compose rm --stop --force mysql-schema' EXIT

compose run --rm migrate-schema

version=$(mysql_exec mysql -uroot -N -e 'SELECT version FROM schema_migrations' activitypub)

{
    echo "-- Generated by \`pnpm schema:dump\` from migrations up to ${version}"
    echo "-- For reference only. It is not applied to any database."
    echo "-- Do not edit by hand, add a migration instead."
    echo
    mysql_exec mysqldump -uroot --no-data --compact --no-tablespaces \
        --ignore-table=activitypub.schema_migrations activitypub |
        sed -E -e '/^\/\*!/d' -e 's/ AUTO_INCREMENT=[0-9]+//' |
        awk '{ print } /^\) ENGINE=/ { print "" }'
} >"$out.tmp"

mv "$out.tmp" "$out"
echo "Wrote $out"
